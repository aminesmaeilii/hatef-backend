  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "otplib": "^13.4.1",
    "rimraf": "6.0.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
