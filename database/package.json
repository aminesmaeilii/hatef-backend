{
  "name": "@hatef/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- prisma generate --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf generated dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "create:test-admin": "dotenv -e ../.env -- tsx src/create-test-admin.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@hatef/auth": "workspace:^",
    "@hatef/config": "workspace:^",
    "@hatef/domain": "workspace:^",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prisma": "6.19.3",
    "rimraf": "6.0.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
