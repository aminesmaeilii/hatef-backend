# ---------------------------------------------------------------------------
# Hatef Platform — staging environment template.
# Copy to .env on the staging host and replace every <REPLACE_ME> value.
#
# Staging intentionally runs with NODE_ENV=production — the whole point of
# a staging environment is to exercise the same hard guarantees production
# has (see backend/config/src/env.schema.ts's assertNotDevelopmentSecret):
# no default session/OTP secrets, no dev SMS provider, no dev antivirus
# provider. A staging environment that quietly runs in "development" mode
# would never actually prove the live SMS/antivirus integrations work
# before a real production release depends on them.
# ---------------------------------------------------------------------------

NODE_ENV=production
APP_TIMEZONE=Asia/Tehran

# --- Ports ---------------------------------------------------------------
API_PORT=4000
ADMIN_WEB_PORT=3000
PARTNER_WEB_PORT=3001
WORKER_PORT=4100

# Real staging domains — CORS (see backend/api/src/main.ts) only allows
# exactly these two origins, and the Next.js CSP `connect-src` in both
# next.config.ts files is built from NEXT_PUBLIC_API_URL, so all three must
# match the domains actually serving each app.
API_URL=https://api-staging.<REPLACE_ME>
ADMIN_WEB_URL=https://admin-staging.<REPLACE_ME>
PARTNER_WEB_URL=https://app-staging.<REPLACE_ME>
NEXT_PUBLIC_API_URL=https://api-staging.<REPLACE_ME>

# --- PostgreSQL ------------------------------------------------------------
# A managed/staging-tier instance, not the docker-compose one — never point
# staging at the same Postgres instance as production.
DATABASE_URL=postgresql://<REPLACE_ME>

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://<REPLACE_ME>

# --- Object storage (a staging-only bucket, never the production bucket) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=<REPLACE_ME>
STORAGE_REGION=<REPLACE_ME>
STORAGE_ACCESS_KEY_ID=<REPLACE_ME>
STORAGE_SECRET_ACCESS_KEY=<REPLACE_ME>
STORAGE_BUCKET=hatef-staging
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Auth / sessions -----------------------------------------------------
# Generate real, staging-only secrets — never reuse production's:
#   openssl rand -base64 48
SESSION_SECRET=<REPLACE_ME_GENERATE_A_REAL_SECRET>
SESSION_COOKIE_NAME=hatef_session
OTP_HASH_PEPPER=<REPLACE_ME_GENERATE_A_REAL_SECRET>
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MFA_ISSUER=Hatef Staging

# --- SMS provider ----------------------------------------------------------
# Use the SMS provider's own staging/sandbox credentials if it offers one —
# the point of staging is to prove the live adapter path actually works,
# not to fully re-exercise production's real message costs/delivery.
SMS_PROVIDER=live
FEATURE_SMS_PROVIDER_LIVE=true
SMS_PROVIDER_API_KEY=<REPLACE_ME>
SMS_PROVIDER_USERNAME=<REPLACE_ME>
SMS_PROVIDER_PASSWORD=<REPLACE_ME>
SMS_PROVIDER_SENDER=<REPLACE_ME>
SMS_TEMPLATE_OTP_ID=<REPLACE_ME>

# --- Object/file scanning ------------------------------------------------
ANTIVIRUS_PROVIDER=live
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_CHANNEL=500

# --- Feature flags -------------------------------------------------------
FEATURE_WEB_PUSH=false
FEATURE_SURVEYS=true
FEATURE_SKIP_ADMIN_MFA_IN_DEV=false

# --- Web push (optional, feature-flagged) -------------------------------
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info

# --- API rate limiting -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
