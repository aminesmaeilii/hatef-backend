// Hatef Platform — Prisma schema
// Phase 0 establishes the migration mechanism and the platform-wide tables
// (feature flags, audit log) that every later domain module depends on.
// Identity, channel, form, promotion, operations, barter, ledger, and
// communication tables are added module-by-module in later phases.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-wide feature flags. Read at startup and cached; never the
/// authoritative store for business data, only for enabling/disabling
/// optional integrations (e.g. live SMS, web push).
model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Append-only audit trail for every important action in the system.
/// Never hard-deleted. actorId/actorType are denormalized so the log
/// survives even if the acting user/session record is later removed.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  actorType     String   @map("actor_type")
  actorLabel    String?  @map("actor_label")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  metadata      Json?
  correlationId String?  @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Transactional outbox for reliable cross-module and cross-process events
/// (e.g. API -> worker). Rows are inserted in the same transaction as the
/// business write and published by the worker afterward.
model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @map("event_type")
  payload       Json
  correlationId String?           @map("correlation_id")
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  availableAt   DateTime          @default(now()) @map("available_at")
  processedAt   DateTime?         @map("processed_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

/// Guards against duplicate side effects from retried requests/jobs.
model IdempotencyKey {
  key          String   @id
  requestHash  String   @map("request_hash")
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity, RBAC/ABAC, channels + memberships, files.
// Full 360-degree channel profile, onboarding forms, and evaluation workflow
// are added in Phase 2.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A person, internal or partner. Which side they're on is determined by
/// whether they have an AdminCredential (internal) and/or channel
/// memberships (partner) — not a hardcoded "kind" column, since a person
/// could plausibly be both in later phases.
model User {
  id          String     @id @default(uuid()) @db.Uuid
  displayName String     @map("display_name")
  email       String?    @unique
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  contacts                      UserContact[]
  adminCredential               AdminCredential?
  mfaMethods                    MfaMethod[]
  mfaRecoveryCodes              MfaRecoveryCode[]
  roleAssignments               RoleAssignment[]
  authSessions                  AuthSession[]
  channelMemberships            ChannelMembership[]
  uploadedFiles                 FileAsset[]
  fileAccessEvents              FileAccessEvent[]
  formSubmissions               FormSubmission[]
  consentAcceptances            ConsentAcceptance[]
  evaluationAssignments         EvaluationAssignment[]
  evaluationScores              EvaluationScore[]
  supportRequests               SupportRequest[]
  assignedTasks                 Task[]                     @relation("TaskAssignee")
  createdTasks                  Task[]                     @relation("TaskCreator")
  taskComments                  TaskComment[]
  capacityResources             CapacityResource[]
  promotionSchedules            PromotionSchedule[]
  obligationsCreated            ServiceObligation[]        @relation("ObligationCreatedBy")
  obligationsResponsibleChannel ServiceObligation[]        @relation("ObligationResponsibleChannelMember")
  obligationsResponsibleHatef   ServiceObligation[]        @relation("ObligationResponsibleHatefEmployee")
  obligationProposals           ObligationProposal[]
  deliverablesSubmitted         Deliverable[]
  deliverableReviews            DeliverableReview[]
  disputesRaised                Dispute[]                  @relation("DisputeRaisedBy")
  disputesResolved              Dispute[]                  @relation("DisputeResolvedBy")
  settlementsCreated            Settlement[]
  financialApprovalRequests     FinancialApprovalRequest[] @relation("FinancialApprovalRequestedBy")
  financialApprovalDecisions    FinancialApprovalRequest[] @relation("FinancialApprovalDecidedBy")
  assignedTickets               Ticket[]                   @relation("TicketAssignee")
  createdTickets                Ticket[]                   @relation("TicketCreatedBy")
  ticketMessages                TicketMessage[]            @relation("TicketMessageAuthor")
  ticketInternalNotes           TicketInternalNote[]       @relation("TicketInternalNoteAuthor")
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationQuietHours        NotificationQuietHours?
  surveysCreated                Survey[]
  reportDefinitionsCreated      ReportDefinition[]
  reportRunsRequested           ReportRun[]
  reportSnapshotsCreated        ReportSnapshot[]

  @@map("users")
}

enum ContactType {
  MOBILE
  EMAIL
}

/// Normalized contact points used to look a user up at login (partner OTP by
/// mobile, internal login by email). A contact value is globally unique so
/// OTP verification and login can resolve to exactly one user.
model UserContact {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       ContactType
  value      String
  verifiedAt DateTime?   @map("verified_at")
  isPrimary  Boolean     @default(false) @map("is_primary")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([userId])
  @@map("user_contacts")
}

/// Internal (email/password) login credential. Partner users authenticate
/// via OTP only and never get one of these.
model AdminCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

enum MfaType {
  TOTP
}

/// TOTP MFA enrollment for privileged internal roles. `secretEncrypted` is
/// AES-256-GCM ciphertext (see packages/auth/src/crypto.ts), never the raw
/// secret — the key never lives in the database.
model MfaMethod {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            MfaType
  secretEncrypted String    @map("secret_encrypted")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_methods")
}

/// One-time MFA recovery codes. Hashed the same way as OTP codes (HMAC +
/// server-side pepper, not Argon2) since these are high-entropy generated
/// codes, not user-chosen secrets vulnerable to dictionary attack.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

enum RoleScope {
  INTERNAL
  PARTNER
}

/// Role catalog (13 internal + 4 partner roles from the product spec).
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

/// Permission catalog. Phase 1 seeds only what Phase 1 needs; later phases
/// add rows here as their modules are built — this table is additive only.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's grant of a role, optionally scoped to one resource (e.g. a
/// specific channel). No resourceType/resourceId = granted everywhere. This
/// is the persisted form of packages/auth's RoleAssignment shape.
model RoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, resourceType, resourceId])
  @@index([userId])
  @@map("role_assignments")
}

/// A DB-backed login session. The cookie holds a random opaque token; only
/// its SHA-256 hash is stored here, mirroring the OTP-hashing pattern.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  csrfToken        String    @map("csrf_token")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  stepUpVerifiedAt DateTime? @map("step_up_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum OtpPurpose {
  LOGIN
}

/// One row per OTP send attempt. Fast-path rate limiting (per-phone cooldown,
/// per-IP request counts) lives in Redis; this table is the durable record
/// used for attempt-limit/expiry checks and the security audit trail.
model OtpChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  mobile            String
  codeHash          String     @map("code_hash")
  purpose           OtpPurpose @default(LOGIN)
  attempts          Int        @default(0)
  maxAttempts       Int        @map("max_attempts")
  expiresAt         DateTime   @map("expires_at")
  consumedAt        DateTime?  @map("consumed_at")
  resendAvailableAt DateTime   @map("resend_available_at")
  requestIp         String?    @map("request_ip")
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([mobile, createdAt])
  @@map("otp_challenges")
}

enum ChannelStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Minimal channel entity — just enough to hang memberships, files, and
/// permissions off of. Full 360-degree profile/assessment fields arrive in
/// Phase 2 as additive columns/tables, never breaking this shape.
model Channel {
  id        String        @id @default(uuid()) @db.Uuid
  title     String
  eitaaId   String        @unique @map("eitaa_id")
  status    ChannelStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  memberships               ChannelMembership[]
  files                     FileAsset[]
  formSubmissions           FormSubmission[]
  evaluationCases           EvaluationCase[]
  supportRequests           SupportRequest[]
  promotionOrders           PromotionOrder[]
  tasks                     Task[]
  calendarEvents            CalendarEvent[]
  dateNotes                 DateNote[]
  serviceObligations        ServiceObligation[]
  ledgerAccounts            LedgerAccount[]
  settlements               Settlement[]
  rateCards                 ChannelRateCard[]
  financialApprovalRequests FinancialApprovalRequest[]
  tickets                   Ticket[]

  @@map("channels")
}

enum ChannelRole {
  CHANNEL_OWNER
  CHANNEL_ADMIN
  CHANNEL_FINANCE_VIEWER
  CHANNEL_TEAM_MEMBER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model ChannelMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  channelId String           @map("channel_id") @db.Uuid
  role      ChannelRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("channel_memberships")
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
}

/// Persistent metadata for every uploaded file. The bytes live in MinIO/S3
/// under `storageKey`; this row is what makes "uploaded file metadata
/// persists" (the phase's exit proof) provable.
model FileAsset {
  id             String         @id @default(uuid()) @db.Uuid
  uploaderId     String         @map("uploader_id") @db.Uuid
  channelId      String?        @map("channel_id") @db.Uuid
  entityType     String?        @map("entity_type")
  entityId       String?        @map("entity_id") @db.Uuid
  storageKey     String         @unique @map("storage_key")
  originalName   String         @map("original_name")
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes")
  checksumSha256 String         @map("checksum_sha256")
  scanStatus     FileScanStatus @default(PENDING) @map("scan_status")
  createdAt      DateTime       @default(now()) @map("created_at")

  uploader                User                      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  channel                 Channel?                  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  accessEvents            FileAccessEvent[]
  promotionAssets         PromotionAsset[]
  taskAttachments         TaskAttachment[]
  promotionResultEvidence PromotionResultEvidence[]
  obligationAttachments   ObligationAttachment[]
  deliverableAttachments  DeliverableAttachment[]
  ticketAttachments       TicketAttachment[]

  @@index([channelId])
  @@index([uploaderId])
  @@map("files")
}

enum FileAccessAction {
  UPLOAD
  VIEW
  DOWNLOAD
  DOWNLOAD_BLOCKED
}

model FileAccessEvent {
  id        String           @id @default(uuid()) @db.Uuid
  fileId    String           @map("file_id") @db.Uuid
  actorId   String           @map("actor_id") @db.Uuid
  action    FileAccessAction
  ipAddress String?          @map("ip_address")
  createdAt DateTime         @default(now()) @map("created_at")

  file  FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  actor User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([actorId])
  @@map("file_access_events")
}

// ---------------------------------------------------------------------------
// Phase 2 — Form engine, 28-question onboarding, evaluation workflow.
// Full 360-degree profile sections that depend on later phases (ledger,
// tickets, tasks, promotion orders) are added when those phases land.
// ---------------------------------------------------------------------------

enum FormVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A named, reusable form definition container (onboarding today, surveys in
/// a later phase reusing the same engine). The live definition is whichever
/// FormVersion has status PUBLISHED — at most one per form, enforced by
/// FormsService.publish() archiving the previous one in the same transaction
/// that publishes the new one (not a DB constraint, matching how Phase 1's
/// AuthSession revocation is also application-enforced, not DB-enforced).
model Form {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions FormVersion[]
  survey   Survey?

  @@map("forms")
}

/// One immutable-once-published snapshot of a form's structure. Existing
/// FormSubmissions keep pointing at the exact version they were started
/// against even after a newer version publishes — this is what makes "form
/// version changes never alter historical submissions" true.
model FormVersion {
  id            String            @id @default(uuid()) @db.Uuid
  formId        String            @map("form_id") @db.Uuid
  versionNumber Int               @map("version_number")
  status        FormVersionStatus @default(DRAFT)
  publishedAt   DateTime?         @map("published_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  pages       FormPage[]
  rules       FormRule[]
  submissions FormSubmission[]

  @@unique([formId, versionNumber])
  @@index([formId, status])
  @@map("form_versions")
}

model FormPage {
  id            String  @id @default(uuid()) @db.Uuid
  formVersionId String  @map("form_version_id") @db.Uuid
  order         Int
  title         String
  description   String?

  formVersion FormVersion   @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  sections    FormSection[]

  @@index([formVersionId])
  @@map("form_pages")
}

model FormSection {
  id          String  @id @default(uuid()) @db.Uuid
  formPageId  String  @map("form_page_id") @db.Uuid
  order       Int
  title       String
  description String?

  formPage FormPage    @relation(fields: [formPageId], references: [id], onDelete: Cascade)
  fields   FormField[]

  @@index([formPageId])
  @@map("form_sections")
}

enum FormFieldType {
  TEXT
  LONG_TEXT
  PHONE
  NUMBER
  JALALI_DATE
  SINGLE_SELECT
  MULTI_SELECT
  REPEATABLE_GROUP
  IMAGE
  DOCUMENT
  LINK
  CONSENT
}

/// `key` (e.g. "eitaa_channel_id") must be unique within a FormVersion —
/// enforced by FormsService, not a DB constraint (Prisma can't scope a
/// unique index to an ancestor two joins up without denormalizing
/// formVersionId onto every field row). `config` holds type-specific shape:
/// for REPEATABLE_GROUP, the child-item field list lives here as JSON
/// rather than as recursive FormField rows — the spec asks for a
/// repeatable-group *field type*, not infinite nesting.
model FormField {
  id            String        @id @default(uuid()) @db.Uuid
  formSectionId String        @map("form_section_id") @db.Uuid
  order         Int
  key           String
  label         String
  type          FormFieldType
  required      Boolean       @default(false)
  helpText      String?       @map("help_text")
  placeholder   String?
  config        Json?
  createdAt     DateTime      @default(now()) @map("created_at")

  formSection   FormSection       @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  options       FormFieldOption[]
  targetOfRules FormRule[]        @relation("TargetField")
  answers       FormAnswer[]

  @@index([formSectionId])
  @@map("form_fields")
}

model FormFieldOption {
  id          String @id @default(uuid()) @db.Uuid
  formFieldId String @map("form_field_id") @db.Uuid
  order       Int
  value       String
  label       String

  formField FormField @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@index([formFieldId])
  @@map("form_field_options")
}

enum FormRuleAction {
  SHOW
  REQUIRE
  HIDE
}

/// `condition` is `{ sourceFieldKey, operator, value }` — evaluated by
/// packages/domain's evaluateFieldVisibility, the single source of truth
/// used both by the server (authoritative, at submit time) and the partner
/// wizard (live show/hide as the user types).
model FormRule {
  id            String         @id @default(uuid()) @db.Uuid
  formVersionId String         @map("form_version_id") @db.Uuid
  targetFieldId String         @map("target_field_id") @db.Uuid
  action        FormRuleAction
  condition     Json
  createdAt     DateTime       @default(now()) @map("created_at")

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  targetField FormField   @relation("TargetField", fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@index([formVersionId])
  @@map("form_rules")
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
}

/// One per (channel, form) — corrections/resubmissions add new
/// FormSubmissionRevision rows to the same submission, they never create a
/// second FormSubmission.
model FormSubmission {
  id                    String               @id @default(uuid()) @db.Uuid
  formVersionId         String               @map("form_version_id") @db.Uuid
  channelId             String               @map("channel_id") @db.Uuid
  submitterId           String               @map("submitter_id") @db.Uuid
  status                FormSubmissionStatus @default(DRAFT)
  currentRevisionNumber Int                  @default(0) @map("current_revision_number")
  submittedAt           DateTime?            @map("submitted_at")
  lastAutosaveAt        DateTime?            @map("last_autosave_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  formVersion    FormVersion              @relation(fields: [formVersionId], references: [id])
  channel        Channel                  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  submitter      User                     @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  answers        FormAnswer[]
  revisions      FormSubmissionRevision[]
  consents       ConsentAcceptance[]
  evaluationCase EvaluationCase?

  @@index([channelId])
  @@map("form_submissions")
}

/// The mutable, currently-being-edited answer set. Autosave upserts here;
/// submitting copies it into an immutable FormSubmissionRevision snapshot.
model FormAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  formSubmissionId String   @map("form_submission_id") @db.Uuid
  formFieldId      String   @map("form_field_id") @db.Uuid
  value            Json
  updatedAt        DateTime @updatedAt @map("updated_at")

  formSubmission FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  formField      FormField      @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@unique([formSubmissionId, formFieldId])
  @@map("form_answers")
}

/// Immutable — never updated after insert. `snapshot` is the full answer
/// set at that moment, keyed by field key. Revision diffs are just
/// `revision[n].snapshot` vs `revision[n-1].snapshot`.
model FormSubmissionRevision {
  id               String   @id @default(uuid()) @db.Uuid
  formSubmissionId String   @map("form_submission_id") @db.Uuid
  revisionNumber   Int      @map("revision_number")
  snapshot         Json
  submittedAt      DateTime @default(now()) @map("submitted_at")
  submittedBy      String   @map("submitted_by") @db.Uuid

  formSubmission FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)

  @@unique([formSubmissionId, revisionNumber])
  @@map("form_submission_revisions")
}

/// "Separately versioned confirmations" (spec: accuracy declaration, terms
/// and privacy policy).
model ConsentDocument {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  version     Int
  title       String
  body        String
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  acceptances ConsentAcceptance[]

  @@unique([key, version])
  @@map("consent_documents")
}

model ConsentAcceptance {
  id                String   @id @default(uuid()) @db.Uuid
  consentDocumentId String   @map("consent_document_id") @db.Uuid
  formSubmissionId  String   @map("form_submission_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at")
  ipAddress         String?  @map("ip_address")

  consentDocument ConsentDocument @relation(fields: [consentDocumentId], references: [id])
  formSubmission  FormSubmission  @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formSubmissionId])
  @@map("consent_acceptances")
}

enum EvaluationCaseStatus {
  DRAFT
  SUBMITTED
  IDENTITY_CHECK
  UNDER_REVIEW
  NEEDS_CHANGES
  RESUBMITTED
  APPROVED
  CONDITIONALLY_APPROVED
  WAITLISTED
  REJECTED
}

/// One per FormSubmission. Status is driven exclusively through
/// packages/domain's StateMachine (see evaluation/evaluation-state-machine.ts)
/// — never hand-rolled if/else status checks.
model EvaluationCase {
  id               String               @id @default(uuid()) @db.Uuid
  channelId        String               @map("channel_id") @db.Uuid
  formSubmissionId String               @unique @map("form_submission_id") @db.Uuid
  status           EvaluationCaseStatus @default(DRAFT)
  slaDueAt         DateTime?            @map("sla_due_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  channel        Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  formSubmission FormSubmission          @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  assignments    EvaluationAssignment[]
  scores         EvaluationScore[]
  decisions      EvaluationDecision[]
  infoRequests   InformationRequest[]
  notes          EvaluationNote[]
  statusEvents   EvaluationStatusEvent[]

  @@index([channelId])
  @@index([status])
  @@map("evaluation_cases")
}

enum EvaluationAssignmentRole {
  EVALUATOR
  SUPERVISOR
}

model EvaluationAssignment {
  id               String                   @id @default(uuid()) @db.Uuid
  evaluationCaseId String                   @map("evaluation_case_id") @db.Uuid
  evaluatorId      String                   @map("evaluator_id") @db.Uuid
  role             EvaluationAssignmentRole
  conflictDeclared Boolean                  @default(false) @map("conflict_declared")
  conflictNote     String?                  @map("conflict_note")
  assignedAt       DateTime                 @default(now()) @map("assigned_at")
  unassignedAt     DateTime?                @map("unassigned_at")

  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)
  evaluator      User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@index([evaluatorId])
  @@map("evaluation_assignments")
}

enum RubricStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Flat criteria array (`Json`: `[{key,label,maxScore,weight}]`) — simpler
/// shape than Form's page/section/field tree, versioned the same way (a
/// version already scored against is never edited; editing creates a new
/// version).
model EvaluationRubric {
  id            String       @id @default(uuid()) @db.Uuid
  key           String
  versionNumber Int          @map("version_number")
  title         String
  criteria      Json
  status        RubricStatus @default(DRAFT)
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  scores EvaluationScore[]

  @@unique([key, versionNumber])
  @@map("evaluation_rubrics")
}

model EvaluationScore {
  id                 String   @id @default(uuid()) @db.Uuid
  evaluationCaseId   String   @map("evaluation_case_id") @db.Uuid
  rubricId           String   @map("rubric_id") @db.Uuid
  evaluatorId        String   @map("evaluator_id") @db.Uuid
  scores             Json
  confidence         Int
  overrideReason     String?  @map("override_reason")
  supervisorApproved Boolean  @default(false) @map("supervisor_approved")
  createdAt          DateTime @default(now()) @map("created_at")

  evaluationCase EvaluationCase   @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)
  rubric         EvaluationRubric @relation(fields: [rubricId], references: [id])
  evaluator      User             @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@map("evaluation_scores")
}

enum EvaluationDecisionType {
  APPROVED
  CONDITIONALLY_APPROVED
  WAITLISTED
  REJECTED
}

/// `reason` is internal-only; `partnerVisibleReason` is the safe text shown
/// to the partner — never the same field, never derived by truncating the
/// internal one.
model EvaluationDecision {
  id                   String                 @id @default(uuid()) @db.Uuid
  evaluationCaseId     String                 @map("evaluation_case_id") @db.Uuid
  decision             EvaluationDecisionType
  reason               String
  partnerVisibleReason String                 @map("partner_visible_reason")
  decidedBy            String                 @map("decided_by") @db.Uuid
  decidedAt            DateTime               @default(now()) @map("decided_at")

  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@map("evaluation_decisions")
}

enum InformationRequestStatus {
  OPEN
  RESOLVED
}

/// = "correction request". `requestedFieldKeys` (Json string array) names
/// exactly which FormField.key values the partner must fix — the partner
/// wizard only reopens those fields for editing (field-level resubmission).
model InformationRequest {
  id                 String                   @id @default(uuid()) @db.Uuid
  evaluationCaseId   String                   @map("evaluation_case_id") @db.Uuid
  requestedFieldKeys Json                     @map("requested_field_keys")
  message            String
  status             InformationRequestStatus @default(OPEN)
  createdBy          String                   @map("created_by") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at")
  resolvedAt         DateTime?                @map("resolved_at")

  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@map("information_requests")
}

/// Internal-only. No partner-facing serializer/endpoint may ever select
/// from this table — same "never leaks" discipline as ticket internal notes
/// (spec section 18), applied here from the start.
model EvaluationNote {
  id               String   @id @default(uuid()) @db.Uuid
  evaluationCaseId String   @map("evaluation_case_id") @db.Uuid
  authorId         String   @map("author_id") @db.Uuid
  body             String
  createdAt        DateTime @default(now()) @map("created_at")

  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@map("evaluation_notes")
}

/// The durable transition log every EvaluationCase StateMachine transition
/// writes. Both the partner-facing "public assessment timeline" and the
/// admin 360-profile "unified timeline" are filtered reads over this table
/// (partnerVisible: true for the partner-facing one) — no separate
/// timeline table needed.
model EvaluationStatusEvent {
  id               String                @id @default(uuid()) @db.Uuid
  evaluationCaseId String                @map("evaluation_case_id") @db.Uuid
  fromStatus       EvaluationCaseStatus? @map("from_status")
  toStatus         EvaluationCaseStatus  @map("to_status")
  note             String?
  partnerVisible   Boolean               @default(false) @map("partner_visible")
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")

  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)

  @@index([evaluationCaseId])
  @@map("evaluation_status_events")
}

// ---------------------------------------------------------------------------
// Phase 3 — Promotion types, first-position pin pricing, variable
// multi-channel quote workflow, support-request state machine, operational
// queues/Kanban, partner progress. Scheduling/execution (calendar, Gantt,
// evidence, actual results) is Phase 4 territory and attaches to
// PromotionOrder once it exists.
// ---------------------------------------------------------------------------

enum PromotionPricingModel {
  CALCULATED
  QUOTE
}

/// Catalog of promotional-support offerings (first-position pin, variable
/// multi-channel, "future configurable promotion types" per spec).
/// `pricingModel` drives which workflow a SupportRequest referencing this
/// type follows — CALCULATED uses the backend PriceRule formula, QUOTE uses
/// the PromotionQuote negotiation workflow. Never a separate "kind" column
/// duplicating this.
model PromotionType {
  id           String                @id @default(uuid()) @db.Uuid
  key          String                @unique
  name         String
  description  String?
  pricingModel PromotionPricingModel @map("pricing_model")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  versions        PromotionTypeVersion[]
  supportRequests SupportRequest[]

  @@map("promotion_types")
}

enum PromotionTypeVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Effective-dated, immutable-once-published pricing configuration for a
/// PromotionType (see PriceRule for the actual rate lines). Changing the
/// configured rate never touches a request that already snapshotted an
/// earlier version's rate into its PriceCalculation — same
/// clone-into-new-draft discipline as Phase 2's FormVersion.
model PromotionTypeVersion {
  id              String                     @id @default(uuid()) @db.Uuid
  promotionTypeId String                     @map("promotion_type_id") @db.Uuid
  versionNumber   Int                        @map("version_number")
  status          PromotionTypeVersionStatus @default(DRAFT)
  effectiveFrom   DateTime?                  @map("effective_from")
  publishedAt     DateTime?                  @map("published_at")
  createdAt       DateTime                   @default(now()) @map("created_at")

  promotionType     PromotionType      @relation(fields: [promotionTypeId], references: [id], onDelete: Cascade)
  priceRules        PriceRule[]
  priceCalculations PriceCalculation[]

  @@unique([promotionTypeId, versionNumber])
  @@index([promotionTypeId, status])
  @@map("promotion_type_versions")
}

enum AudienceType {
  NATIONWIDE
  PROVINCIAL
}

/// One rate line within a PromotionTypeVersion, e.g. "NATIONWIDE -> 240
/// rial/unique view". `audienceType` null is reserved for a future
/// audience-agnostic CALCULATED type; today every seeded rule names one.
model PriceRule {
  id                     String        @id @default(uuid()) @db.Uuid
  promotionTypeVersionId String        @map("promotion_type_version_id") @db.Uuid
  audienceType           AudienceType? @map("audience_type")
  ratePerViewRial        BigInt        @map("rate_per_view_rial")
  minAmountRial          BigInt?       @map("min_amount_rial")
  capAmountRial          BigInt?       @map("cap_amount_rial")
  createdAt              DateTime      @default(now()) @map("created_at")

  promotionTypeVersion PromotionTypeVersion @relation(fields: [promotionTypeVersionId], references: [id], onDelete: Cascade)

  @@unique([promotionTypeVersionId, audienceType])
  @@map("price_rules")
}

enum SupportRequestStatus {
  DRAFT
  SUBMITTED
  VALIDATION
  NEEDS_PARTNER_CHANGES
  PRICING_OR_QUOTE
  INTERNAL_APPROVAL
  PARTNER_CONFIRMATION
  SCHEDULED
  RUNNING
  RESULT_VERIFICATION
  ADJUSTMENT_REQUIRED
  COMPLETED
  CANCEL_REQUESTED
  CANCELLED
  DISPUTED
}

/// A partner's promotional-support request — first-position pin
/// (CALCULATED pricing) or a variable multi-channel promotion (QUOTE
/// pricing). Which workflow applies is read from `promotionType.pricingModel`
/// at runtime. Status is driven exclusively through the packages/domain
/// StateMachine in apps/api/src/promotions/support-request-state-machine.ts,
/// same discipline as Phase 2's EvaluationCase. `audienceType`/`province`/
/// `requestedUniqueViews` are the only partner fields the pricing formula
/// consumes, so they're real columns; everything else (title, ad text,
/// target link, notes, objective/topic/geography for variable requests, ...)
/// lives in `details` — same "structured where it's load-bearing, JSON where
/// it's presentational" split the form engine uses for FormField.config.
model SupportRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  channelId             String               @map("channel_id") @db.Uuid
  promotionTypeId       String               @map("promotion_type_id") @db.Uuid
  requestedById         String               @map("requested_by_id") @db.Uuid
  status                SupportRequestStatus @default(DRAFT)
  audienceType          AudienceType?        @map("audience_type")
  province              String?
  requestedUniqueViews  Int?                 @map("requested_unique_views")
  details               Json                 @default("{}")
  currentRevisionNumber Int                  @default(0) @map("current_revision_number")
  submittedAt           DateTime?            @map("submitted_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  channel           Channel                     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  promotionType     PromotionType               @relation(fields: [promotionTypeId], references: [id])
  requestedBy       User                        @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  revisions         SupportRequestRevision[]
  statusEvents      SupportRequestStatusEvent[]
  priceCalculations PriceCalculation[]
  quote             PromotionQuote?
  order             PromotionOrder?
  assets            PromotionAsset[]
  obligations       ServiceObligation[]

  @@index([channelId])
  @@index([status])
  @@map("support_requests")
}

/// Immutable snapshot of partner-submitted request details taken at each
/// submit/resubmit — same shape/purpose as Phase 2's FormSubmissionRevision.
model SupportRequestRevision {
  id               String   @id @default(uuid()) @db.Uuid
  supportRequestId String   @map("support_request_id") @db.Uuid
  revisionNumber   Int      @map("revision_number")
  snapshot         Json
  submittedAt      DateTime @default(now()) @map("submitted_at")
  submittedBy      String   @map("submitted_by") @db.Uuid

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@unique([supportRequestId, revisionNumber])
  @@map("support_request_revisions")
}

/// Durable transition log, mirroring Phase 2's EvaluationStatusEvent — backs
/// both the admin operational queue/Kanban history and the partner-facing
/// progress timeline (partnerVisible: true rows only).
model SupportRequestStatusEvent {
  id               String                @id @default(uuid()) @db.Uuid
  supportRequestId String                @map("support_request_id") @db.Uuid
  fromStatus       SupportRequestStatus? @map("from_status")
  toStatus         SupportRequestStatus  @map("to_status")
  note             String?
  partnerVisible   Boolean               @default(false) @map("partner_visible")
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@index([supportRequestId])
  @@map("support_request_status_events")
}

/// One row per price computation, recomputation, or override — never
/// updated after insert (approval fields are the one exception: they
/// annotate this exact calculation once it's accepted, they don't change
/// what was calculated). This is what makes "changing the configured rate
/// must not change an old request" and the required override/second-approval
/// history both just "read the rows in order." Only meaningful for
/// CALCULATED-pricing requests.
model PriceCalculation {
  id                     String       @id @default(uuid()) @db.Uuid
  supportRequestId       String       @map("support_request_id") @db.Uuid
  promotionTypeVersionId String       @map("promotion_type_version_id") @db.Uuid
  requestedUniqueViews   Int          @map("requested_unique_views")
  audienceType           AudienceType @map("audience_type")
  ratePerViewRial        BigInt       @map("rate_per_view_rial")
  baseAmountRial         BigInt       @map("base_amount_rial")
  discountRial           BigInt       @default(0) @map("discount_rial")
  multiplierPercent      Int          @default(100) @map("multiplier_percent")
  estimatedAmountRial    BigInt       @map("estimated_amount_rial")
  lineItems              Json         @map("line_items")
  overrideAmountRial     BigInt?      @map("override_amount_rial")
  overrideReason         String?      @map("override_reason")
  requiresSecondApproval Boolean      @default(false) @map("requires_second_approval")
  approvedAmountRial     BigInt?      @map("approved_amount_rial")
  approvedBy             String?      @map("approved_by") @db.Uuid
  approvedAt             DateTime?    @map("approved_at")
  secondApprovedBy       String?      @map("second_approved_by") @db.Uuid
  secondApprovedAt       DateTime?    @map("second_approved_at")
  reservedAmountRial     BigInt?      @map("reserved_amount_rial")
  realizedAmountRial     BigInt?      @map("realized_amount_rial")
  createdBy              String       @map("created_by") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at")

  supportRequest       SupportRequest       @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  promotionTypeVersion PromotionTypeVersion @relation(fields: [promotionTypeVersionId], references: [id])

  @@index([supportRequestId])
  @@map("price_calculations")
}

enum PromotionQuoteStatus {
  DRAFT
  SENT
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// One per QUOTE-pricing SupportRequest. Individual proposals/counters are
/// PromotionQuoteVersion rows — this row just tracks overall workflow status.
model PromotionQuote {
  id               String               @id @default(uuid()) @db.Uuid
  supportRequestId String               @unique @map("support_request_id") @db.Uuid
  status           PromotionQuoteStatus @default(DRAFT)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  supportRequest SupportRequest          @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  versions       PromotionQuoteVersion[]

  @@map("promotion_quotes")
}

enum PromotionQuoteVersionStatus {
  PROPOSED
  NEGOTIATION_REQUESTED
  ACCEPTED
  REJECTED
  SUPERSEDED
  EXPIRED
}

/// Immutable once created — negotiation creates a new version rather than
/// mutating this one, preserving the full offer history. "Unknown is null
/// with an explicit state, never zero" (spec 13.2): estimatedChannelMin/Max
/// and estimatedViewMin/Max are nullable, not zero.
model PromotionQuoteVersion {
  id                  String                      @id @default(uuid()) @db.Uuid
  quoteId             String                      @map("quote_id") @db.Uuid
  versionNumber       Int                         @map("version_number")
  status              PromotionQuoteVersionStatus @default(PROPOSED)
  estimatedChannelMin Int?                        @map("estimated_channel_min")
  estimatedChannelMax Int?                        @map("estimated_channel_max")
  estimatedViewMin    Int?                        @map("estimated_view_min")
  estimatedViewMax    Int?                        @map("estimated_view_max")
  method              String
  scheduleNote        String?                     @map("schedule_note")
  amountRial          BigInt                      @map("amount_rial")
  assumptions         String?
  expiresAt           DateTime?                   @map("expires_at")
  negotiationNote     String?                     @map("negotiation_note")
  respondedAt         DateTime?                   @map("responded_at")
  createdBy           String                      @map("created_by") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at")

  quote PromotionQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNumber])
  @@map("promotion_quote_versions")
}

/// Created once a SupportRequest's commercial scope is locked (approved
/// price or accepted quote) and the partner has given final confirmation —
/// "promotion becomes schedulable." Phase 4 attaches scheduling/execution
/// tables to this.
model PromotionOrder {
  id               String   @id @default(uuid()) @db.Uuid
  supportRequestId String   @unique @map("support_request_id") @db.Uuid
  channelId        String   @map("channel_id") @db.Uuid
  finalAmountRial  BigInt   @map("final_amount_rial")
  createdAt        DateTime @default(now()) @map("created_at")

  supportRequest  SupportRequest            @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  channel         Channel                   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  schedule        PromotionSchedule?
  executionResult PromotionExecutionResult?

  @@map("promotion_orders")
}

enum PromotionAssetKind {
  IMAGE
  DOCUMENT
}

/// Reuses Phase 1's FileAsset (already uploaded via the channel files
/// endpoint) — this table just links it to the request with a role, the
/// same "reuse, don't rebuild" choice Phase 2 made for onboarding uploads.
model PromotionAsset {
  id               String             @id @default(uuid()) @db.Uuid
  supportRequestId String             @map("support_request_id") @db.Uuid
  fileAssetId      String             @map("file_asset_id") @db.Uuid
  kind             PromotionAssetKind
  createdAt        DateTime           @default(now()) @map("created_at")

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset      @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([supportRequestId, fileAssetId])
  @@map("promotion_assets")
}

// ---------------------------------------------------------------------------
// Phase 4 — Internal tasks, the Jalali calendar/Gantt read-model, and
// promotion scheduling + execution. The calendar and Gantt are never their
// own copy of the data — both are just different renderings of the same
// Task/PromotionSchedule rows (see apps/api/src/calendar's aggregating
// service), which is what makes "calendar and Gantt render the same backing
// data" (the phase's own exit proof) true by construction rather than by
// discipline. All dates persist in UTC; Asia/Tehran/Jalali display
// conversion happens only at the edges (packages/localization), never here.
// ---------------------------------------------------------------------------

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// `linkedEntityType`/`linkedEntityId` is a generic, un-FK'd polymorphic
/// pointer — same "string type + uuid, no relation" shape as AuditLog and
/// FileAsset already use — so a task can link to a channel, assessment,
/// support request, promotion order, or a future obligation/deliverable/
/// ticket (Phase 5/6) without a schema change. `watcherIds` is a native
/// Postgres UUID array rather than a join table: watchers are a lightweight
/// notify-list with no per-row metadata worth normalizing.
model Task {
  id               String       @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  status           TaskStatus   @default(BACKLOG)
  priority         TaskPriority @default(MEDIUM)
  assigneeId       String?      @map("assignee_id") @db.Uuid
  createdById      String       @map("created_by_id") @db.Uuid
  watcherIds       String[]     @map("watcher_ids") @db.Uuid
  channelId        String?      @map("channel_id") @db.Uuid
  linkedEntityType String?      @map("linked_entity_type")
  linkedEntityId   String?      @map("linked_entity_id") @db.Uuid
  startDate        DateTime?    @map("start_date")
  dueDate          DateTime?    @map("due_date")
  estimateMinutes  Int?         @map("estimate_minutes")
  reminderAt       DateTime?    @map("reminder_at")
  checklistItems   Json         @default("[]") @map("checklist_items")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  assignee     User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  channel      Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  dependsOn    TaskDependency[]  @relation("TaskDependent")
  dependents   TaskDependency[]  @relation("TaskDependsOn")
  comments     TaskComment[]
  attachments  TaskAttachment[]
  statusEvents TaskStatusEvent[]

  @@index([assigneeId])
  @@index([status])
  @@index([channelId])
  @@index([linkedEntityType, linkedEntityId])
  @@map("tasks")
}

/// `task` depends on `dependsOnTask` — `task` cannot legally start before
/// `dependsOnTask` is due (enforced in TasksService, not the DB), which is
/// what gives the Gantt's "invalid drag" case real content.
model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  task          Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

/// Reuses Phase 1's FileAsset — same "reuse, don't rebuild" choice as
/// PromotionAsset.
model TaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  fileAssetId String   @map("file_asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileAssetId])
  @@map("task_attachments")
}

/// The durable transition log a task's `status` changes write — this *is*
/// the task's "activity history" (spec 14.1) and, combined with
/// SupportRequestStatusEvent, the calendar's "change history" (spec 14.2).
model TaskStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  note       String?
  createdBy  String?     @map("created_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_status_events")
}

/// Freeform calendar entries not backed by a task or a promotion schedule
/// (e.g. "team meeting") — the unified calendar feed
/// (apps/api/src/calendar) merges these with real Task and
/// PromotionSchedule rows rather than this table ever duplicating them.
model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at")
  allDay      Boolean   @default(false) @map("all_day")
  channelId   String?   @map("channel_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@map("calendar_events")
}

/// "Notes on dates" (spec 14.2) — a freeform annotation pinned to one
/// calendar day, independent of any task/event/schedule.
model DateNote {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  note      String
  channelId String?  @map("channel_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("date_notes")
}

/// An operator's scheduling capacity — how many promotions they can run
/// concurrently. Absent an explicit resource, PromotionSchedule conflict
/// detection (packages/domain's findSchedulingConflicts) assumes capacity 1.
model CapacityResource {
  id             String   @id @default(uuid()) @db.Uuid
  operatorId     String   @map("operator_id") @db.Uuid
  capacityPerDay Int      @default(1) @map("capacity_per_day")
  createdAt      DateTime @default(now()) @map("created_at")

  operator  User                @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  schedules PromotionSchedule[]

  @@map("capacity_resources")
}

/// The when/who for a schedulable PromotionOrder (Phase 3's "promotion
/// becomes schedulable" stopping point) — one row per order, updated in
/// place on reschedule (the audit log, not a append-only table here, is
/// what gives reschedule its change history, matching spec 14.2). Conflict
/// detection runs before every create/update, never after.
model PromotionSchedule {
  id                 String    @id @default(uuid()) @db.Uuid
  promotionOrderId   String    @unique @map("promotion_order_id") @db.Uuid
  operatorId         String    @map("operator_id") @db.Uuid
  capacityResourceId String?   @map("capacity_resource_id") @db.Uuid
  scheduledStartAt   DateTime  @map("scheduled_start_at")
  scheduledEndAt     DateTime? @map("scheduled_end_at")
  checklist          Json      @default("[]")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  promotionOrder   PromotionOrder    @relation(fields: [promotionOrderId], references: [id], onDelete: Cascade)
  operator         User              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  capacityResource CapacityResource? @relation(fields: [capacityResourceId], references: [id], onDelete: SetNull)

  @@index([operatorId, scheduledStartAt])
  @@map("promotion_schedules")
}

/// "Actual unique views," "actual channels for variable promotion," and the
/// final realized value once RESULT_VERIFICATION resolves to COMPLETED —
/// one row per order, filled in by the operator (submission) then annotated
/// by whoever verifies it.
model PromotionExecutionResult {
  id                  String    @id @default(uuid()) @db.Uuid
  promotionOrderId    String    @unique @map("promotion_order_id") @db.Uuid
  actualUniqueViews   Int?      @map("actual_unique_views")
  actualChannelsCount Int?      @map("actual_channels_count")
  realizedValueRial   BigInt?   @map("realized_value_rial")
  verifiedAt          DateTime? @map("verified_at")
  verifiedBy          String?   @map("verified_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  promotionOrder PromotionOrder            @relation(fields: [promotionOrderId], references: [id], onDelete: Cascade)
  evidence       PromotionResultEvidence[]

  @@map("promotion_execution_results")
}

/// "Proof upload" (spec 15) — reuses FileAsset, same pattern as
/// PromotionAsset/TaskAttachment.
model PromotionResultEvidence {
  id                         String   @id @default(uuid()) @db.Uuid
  promotionExecutionResultId String   @map("promotion_execution_result_id") @db.Uuid
  fileAssetId                String   @map("file_asset_id") @db.Uuid
  caption                    String?
  createdAt                  DateTime @default(now()) @map("created_at")

  promotionExecutionResult PromotionExecutionResult @relation(fields: [promotionExecutionResultId], references: [id], onDelete: Cascade)
  fileAsset                FileAsset                @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([promotionExecutionResultId, fileAssetId])
  @@map("promotion_result_evidence")
}

// ---------------------------------------------------------------------------
// Phase 5 — Reciprocal service catalog, the obligation workflow, deliverables,
// the immutable double-entry ledger, settlement, and versioned channel rate
// cards. "Do not implement one editable credit balance" (spec 16): every
// balance-affecting fact is a LedgerEntry row that is never updated after
// insert; corrections are always a new REVERSAL LedgerTransaction whose
// entries are the exact mirror of the one it reverses. LedgerTransaction.
// idempotencyKey is what makes "retries cannot duplicate a transaction" true
// by a unique-constraint, not by discipline (see LedgerService.post()).
// ---------------------------------------------------------------------------

enum ServiceType {
  PUBLICATION
  REPOST
  CONTENT_PRODUCTION
  EVENT_COVERAGE
  CAMPAIGN_PARTICIPATION
  FIELD_OPERATION
  NETWORKING
  RESEARCH
  SURVEY
  OTHER
}

/// Catalog entry for a reciprocal-service kind (spec 16.2). Valuation
/// method/unit/acceptance defaults live on the versioned child, not here —
/// same "container + immutable-once-published version" split as
/// PromotionType/PromotionTypeVersion and Form/FormVersion.
model ServiceCatalogItem {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  name        String
  serviceType ServiceType @map("service_type")
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  versions    ServiceCatalogVersion[]
  obligations ServiceObligation[]

  @@map("service_catalog_items")
}

enum ServiceCatalogVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ServiceCatalogVersion {
  id                        String                      @id @default(uuid()) @db.Uuid
  serviceCatalogItemId      String                      @map("service_catalog_item_id") @db.Uuid
  versionNumber             Int                         @map("version_number")
  status                    ServiceCatalogVersionStatus @default(DRAFT)
  unit                      String
  valuationMethod           String                      @map("valuation_method")
  defaultAcceptanceCriteria String?                     @map("default_acceptance_criteria")
  defaultEvidence           String?                     @map("default_evidence")
  priceGuidanceRial         BigInt?                     @map("price_guidance_rial")
  publishedAt               DateTime?                   @map("published_at")
  createdAt                 DateTime                    @default(now()) @map("created_at")

  serviceCatalogItem ServiceCatalogItem  @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Cascade)
  obligations        ServiceObligation[]

  @@unique([serviceCatalogItemId, versionNumber])
  @@index([serviceCatalogItemId, status])
  @@map("service_catalog_versions")
}

enum ObligationStatus {
  PROPOSED
  NEGOTIATING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  PARTIALLY_APPROVED
  APPROVED
  DISPUTED
  SETTLED
  CANCELLED
}

/// A reciprocal-service obligation the channel owes back for support already
/// granted (spec 16.3). `supportRequestId` is the optional link back to the
/// SupportRequest whose COMPLETED verification posted the LedgerTransaction
/// this obligation is settling against — optional because obligations can
/// also be proposed standalone (e.g. a general partnership ask). Status is
/// driven exclusively through packages/domain's StateMachine, same
/// discipline as every prior phase's workflow entities.
model ServiceObligation {
  id                         String           @id @default(uuid()) @db.Uuid
  channelId                  String           @map("channel_id") @db.Uuid
  supportRequestId           String?          @map("support_request_id") @db.Uuid
  serviceCatalogItemId       String           @map("service_catalog_item_id") @db.Uuid
  serviceCatalogVersionId    String           @map("service_catalog_version_id") @db.Uuid
  status                     ObligationStatus @default(PROPOSED)
  brief                      String
  output                     String?
  acceptanceCriteria         String?          @map("acceptance_criteria")
  valueRial                  BigInt           @map("value_rial")
  settledValueRial           BigInt           @default(0) @map("settled_value_rial")
  startAt                    DateTime?        @map("start_at")
  deadlineAt                 DateTime?        @map("deadline_at")
  responsibleChannelMemberId String?          @map("responsible_channel_member_id") @db.Uuid
  responsibleHatefEmployeeId String?          @map("responsible_hatef_employee_id") @db.Uuid
  terms                      String?
  createdById                String           @map("created_by_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  channel                  Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  supportRequest           SupportRequest?         @relation(fields: [supportRequestId], references: [id])
  serviceCatalogItem       ServiceCatalogItem      @relation(fields: [serviceCatalogItemId], references: [id])
  serviceCatalogVersion    ServiceCatalogVersion   @relation(fields: [serviceCatalogVersionId], references: [id])
  responsibleChannelMember User?                   @relation("ObligationResponsibleChannelMember", fields: [responsibleChannelMemberId], references: [id])
  responsibleHatefEmployee User?                   @relation("ObligationResponsibleHatefEmployee", fields: [responsibleHatefEmployeeId], references: [id])
  createdBy                User                    @relation("ObligationCreatedBy", fields: [createdById], references: [id])
  proposals                ObligationProposal[]
  statusEvents             ObligationStatusEvent[]
  attachments              ObligationAttachment[]
  deliverables             Deliverable[]
  disputes                 Dispute[]
  settlementAllocations    SettlementAllocation[]

  @@index([channelId])
  @@index([status])
  @@index([supportRequestId])
  @@map("service_obligations")
}

enum ObligationProposalStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
}

/// Immutable-once-created negotiation round — same "new row per offer,
/// never mutate a prior one" discipline as PromotionQuoteVersion.
model ObligationProposal {
  id            String                   @id @default(uuid()) @db.Uuid
  obligationId  String                   @map("obligation_id") @db.Uuid
  versionNumber Int                      @map("version_number")
  proposedById  String                   @map("proposed_by_id") @db.Uuid
  status        ObligationProposalStatus @default(PROPOSED)
  valueRial     BigInt                   @map("value_rial")
  brief         String?
  deadlineAt    DateTime?                @map("deadline_at")
  note          String?
  respondedAt   DateTime?                @map("responded_at")
  createdAt     DateTime                 @default(now()) @map("created_at")

  obligation ServiceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  proposedBy User              @relation(fields: [proposedById], references: [id])

  @@unique([obligationId, versionNumber])
  @@map("obligation_proposals")
}

/// Durable transition log, same shape as every prior phase's *StatusEvent —
/// backs both the admin obligation timeline and the partner-facing
/// "understandable statement" (spec 16.5).
model ObligationStatusEvent {
  id             String            @id @default(uuid()) @db.Uuid
  obligationId   String            @map("obligation_id") @db.Uuid
  fromStatus     ObligationStatus? @map("from_status")
  toStatus       ObligationStatus  @map("to_status")
  note           String?
  partnerVisible Boolean           @default(true) @map("partner_visible")
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  obligation ServiceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId])
  @@map("obligation_status_events")
}

/// Reuses Phase 1's FileAsset — same "reuse, don't rebuild" choice as
/// PromotionAsset/TaskAttachment.
model ObligationAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  obligationId String   @map("obligation_id") @db.Uuid
  fileAssetId  String   @map("file_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  obligation ServiceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset         @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([obligationId, fileAssetId])
  @@map("obligation_attachments")
}

enum DeliverableStatus {
  SUBMITTED
  NEEDS_REVISION
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  DISPUTED
}

/// A partner's submission against an obligation (spec 16.4). Several
/// deliverables can exist per obligation ("several deliverables against one
/// obligation", spec 16.5); `status` reflects the most recent review, the
/// review history itself lives in DeliverableReview rows.
model Deliverable {
  id            String            @id @default(uuid()) @db.Uuid
  obligationId  String            @map("obligation_id") @db.Uuid
  submittedById String            @map("submitted_by_id") @db.Uuid
  status        DeliverableStatus @default(SUBMITTED)
  description   String?
  links         Json              @default("[]")
  reachOrViews  Int?              @map("reach_or_views")
  deliveredAt   DateTime?         @map("delivered_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  obligation            ServiceObligation       @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  submittedBy           User                    @relation(fields: [submittedById], references: [id])
  attachments           DeliverableAttachment[]
  reviews               DeliverableReview[]
  settlementAllocations SettlementAllocation[]
  disputes              Dispute[]

  @@index([obligationId])
  @@map("deliverables")
}

model DeliverableAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  deliverableId String   @map("deliverable_id") @db.Uuid
  fileAssetId   String   @map("file_asset_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, fileAssetId])
  @@map("deliverable_attachments")
}

enum ReviewDecision {
  ACCEPT_FULL
  ACCEPT_PARTIAL
  REQUEST_REVISION
  REJECT
  DISPUTE
}

/// One row per reviewer action. Partial acceptance requires an explicit
/// accepted amount and the remaining amount (spec 16.4) — both nullable
/// because only ACCEPT_FULL/ACCEPT_PARTIAL populate them, never zero
/// standing in for "not applicable".
model DeliverableReview {
  id                 String         @id @default(uuid()) @db.Uuid
  deliverableId      String         @map("deliverable_id") @db.Uuid
  reviewerId         String         @map("reviewer_id") @db.Uuid
  decision           ReviewDecision
  acceptedValueRial  BigInt?        @map("accepted_value_rial")
  remainingValueRial BigInt?        @map("remaining_value_rial")
  note               String?
  createdAt          DateTime       @default(now()) @map("created_at")

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  @@index([deliverableId])
  @@map("deliverable_reviews")
}

enum DisputeStatus {
  OPEN
  RESOLVED_REVERSED
  RESOLVED_UPHELD
}

/// A dispute always targets exactly one obligation (spec 16.5 "dispute");
/// `deliverableId` narrows it to one specific submission when applicable.
/// Resolution as RESOLVED_REVERSED is what triggers a real LedgerTransaction
/// reversal (see LedgerService.reverse()), never a silent balance edit.
model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  obligationId   String        @map("obligation_id") @db.Uuid
  deliverableId  String?       @map("deliverable_id") @db.Uuid
  raisedById     String        @map("raised_by_id") @db.Uuid
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @map("resolution_note")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  obligation  ServiceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  deliverable Deliverable?      @relation(fields: [deliverableId], references: [id])
  raisedBy    User              @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  resolvedBy  User?             @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([obligationId])
  @@map("disputes")
}

/// Every account this platform's ledger ever posts to. `channelId` is null
/// for the two platform-side contra accounts (spec 16.1's double-entry
/// counterpart to every channel-side fact) — one global row each, not
/// per-channel, since they represent Hatef's own books.
enum LedgerAccountType {
  CHANNEL_SUPPORT_VALUE
  CHANNEL_SERVICE_OBLIGATION
  CHANNEL_SERVICE_DELIVERED
  CHANNEL_SETTLEMENT
  PLATFORM_SUPPORT_POOL
  PLATFORM_SERVICE_POOL
}

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  channelId   String?           @map("channel_id") @db.Uuid
  accountType LedgerAccountType @map("account_type")
  createdAt   DateTime          @default(now()) @map("created_at")

  channel Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([channelId, accountType])
  @@map("ledger_accounts")
}

enum LedgerTransactionType {
  SUPPORT_GRANTED
  SERVICE_ACCEPTED
  SETTLEMENT
  ADJUSTMENT
  REVERSAL
}

/// One row per posting event — never updated after insert (spec 16.1
/// "posted entries are immutable"). `idempotencyKey` is a real unique
/// constraint, not an application check, so a retried request that races
/// past an in-process guard still cannot double-post (spec 16.1 "retries
/// cannot duplicate a transaction", the phase's own exit proof). Corrections
/// never touch this row — LedgerService.reverse() inserts a brand-new
/// REVERSAL transaction whose entries are the exact debit/credit mirror,
/// linked back via `reversalOfTransactionId`.
model LedgerTransaction {
  id                      String                @id @default(uuid()) @db.Uuid
  transactionType         LedgerTransactionType @map("transaction_type")
  idempotencyKey          String                @unique @map("idempotency_key")
  sourceType              String                @map("source_type")
  sourceId                String?               @map("source_id")
  description             String?
  reason                  String?
  reversalOfTransactionId String?               @map("reversal_of_transaction_id") @db.Uuid
  createdBy               String?               @map("created_by") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at")

  reversalOf LedgerTransaction?  @relation("Reversal", fields: [reversalOfTransactionId], references: [id])
  reversals  LedgerTransaction[] @relation("Reversal")
  entries    LedgerEntry[]

  @@index([sourceType, sourceId])
  @@map("ledger_transactions")
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

/// A single balanced line of a LedgerTransaction. Never updated after
/// insert. A channel's balance for any account is always
/// `sum(debit entries) - sum(credit entries)` reconstructed live from this
/// table (spec 16.1 "balances can be reconciled from entries") — there is no
/// cached/editable balance column anywhere in the schema.
model LedgerEntry {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  direction     LedgerEntryDirection
  amountRial    BigInt               @map("amount_rial")
  createdAt     DateTime             @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  REVERSED
}

/// Closes accepted-but-not-yet-settled service value against one or more
/// obligations/deliverables (spec 16.5 "several obligations against one
/// support ... explicit allocation"). `ledgerTransactionId` is only set once
/// COMPLETED — a DRAFT/PENDING_APPROVAL settlement has posted nothing yet.
model Settlement {
  id                  String           @id @default(uuid()) @db.Uuid
  channelId           String           @map("channel_id") @db.Uuid
  status              SettlementStatus @default(DRAFT)
  totalAmountRial     BigInt           @map("total_amount_rial")
  statementNote       String?          @map("statement_note")
  ledgerTransactionId String?          @unique @map("ledger_transaction_id") @db.Uuid
  createdById         String           @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  completedAt         DateTime?        @map("completed_at")

  channel     Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation(fields: [createdById], references: [id])
  allocations SettlementAllocation[]

  @@index([channelId])
  @@map("settlements")
}

/// Explicit per-obligation (optionally per-deliverable) allocation of a
/// Settlement's total — this is what makes "settlement cannot exceed
/// accepted service" (spec 27 invariant) checkable per-row, not just in
/// aggregate.
model SettlementAllocation {
  id            String  @id @default(uuid()) @db.Uuid
  settlementId  String  @map("settlement_id") @db.Uuid
  obligationId  String  @map("obligation_id") @db.Uuid
  deliverableId String? @map("deliverable_id") @db.Uuid
  amountRial    BigInt  @map("amount_rial")

  settlement  Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  obligation  ServiceObligation @relation(fields: [obligationId], references: [id])
  deliverable Deliverable?      @relation(fields: [deliverableId], references: [id])

  @@index([settlementId])
  @@index([obligationId])
  @@map("settlement_allocations")
}

enum FinancialApprovalType {
  LEDGER_ADJUSTMENT
  MANUAL_SETTLEMENT
}

enum FinancialApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Dual-approval gate (spec 16.1 "high-value adjustment requires second
/// approval", 16.5 "manual settlement with dual approval"). `payload` is the
/// not-yet-posted request shape (adjustment entries, or a settlement id) —
/// approving it is what actually calls LedgerService.post()/completeSettlement(),
/// so nothing here ever becomes a balance fact until a second, distinct user
/// signs off.
model FinancialApprovalRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  type          FinancialApprovalType
  channelId     String                  @map("channel_id") @db.Uuid
  amountRial    BigInt                  @map("amount_rial")
  reason        String
  payload       Json
  status        FinancialApprovalStatus @default(PENDING)
  requestedById String                  @map("requested_by_id") @db.Uuid
  requestedAt   DateTime                @default(now()) @map("requested_at")
  decidedById   String?                 @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?               @map("decided_at")
  decisionNote  String?                 @map("decision_note")
  createdAt     DateTime                @default(now()) @map("created_at")

  channel     Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("FinancialApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("FinancialApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([channelId])
  @@index([status])
  @@map("financial_approval_requests")
}

enum RateCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEGOTIATING
  ARCHIVED
}

/// Partner-authored versioned rate card (spec 17). Only one version is ever
/// "current" per channel by convention (highest versionNumber), but old
/// versions are never deleted — same immutable-history discipline as every
/// other *Version model in this schema.
model ChannelRateCard {
  id            String         @id @default(uuid()) @db.Uuid
  channelId     String         @map("channel_id") @db.Uuid
  versionNumber Int            @map("version_number")
  status        RateCardStatus @default(DRAFT)
  submittedAt   DateTime?      @map("submitted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  channel Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   RateCardItem[]

  @@unique([channelId, versionNumber])
  @@index([channelId, status])
  @@map("channel_rate_cards")
}

enum RateCardItemStatus {
  PENDING
  APPROVED
  NEGOTIATING
  ARCHIVED
}

/// One priced offering within a rate card (spec 17's field list). Admin
/// review (comment/approve/negotiate/archive) happens per-item, not per-card
/// — a card can have some approved and some still-negotiating items.
model RateCardItem {
  id              String             @id @default(uuid()) @db.Uuid
  rateCardId      String             @map("rate_card_id") @db.Uuid
  serviceType     ServiceType        @map("service_type")
  title           String
  description     String?
  priceUnit       String             @map("price_unit")
  amountRial      BigInt             @map("amount_rial")
  minimumOrder    Int?               @map("minimum_order")
  leadTimeDays    Int?               @map("lead_time_days")
  monthlyCapacity Int?               @map("monthly_capacity")
  terms           String?
  sampleWorkUrl   String?            @map("sample_work_url")
  effectiveFrom   DateTime?          @map("effective_from")
  expiresAt       DateTime?          @map("expires_at")
  status          RateCardItemStatus @default(PENDING)
  adminComment    String?            @map("admin_comment")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  rateCard ChannelRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId])
  @@map("rate_card_items")
}

// ---------------------------------------------------------------------------
// Phase 6 — Ticketing, notifications/reminders, survey authoring (a thin
// wrapper over the Phase 2 form engine — "reuse, don't rebuild" per spec
// 10.11), and the report builder over approved, code-defined semantic
// datasets rather than unrestricted direct SQL (spec 20). Notification
// delivery and report execution both ride the Phase 0 transactional-outbox
// -> BullMQ worker pipeline already built for exactly this ("Queues,
// notifications, reports, file processing"), rather than a second dispatch
// mechanism.
// ---------------------------------------------------------------------------

enum TicketCategory {
  SUPPORT_REQUEST
  OBLIGATION
  BILLING
  TECHNICAL
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  WAITING_FOR_HATEF
  WAITING_FOR_PARTNER
  RESOLVED
  CLOSED
  REOPENED
}

/// `linkedEntityType`/`linkedEntityId` is the same un-FK'd polymorphic
/// pointer Task/AuditLog/FileAsset already use (spec 18 "linked business
/// record" / spec 29 "linked to any request or obligation"). SLA breach and
/// resolution time are never cached columns — they're derived live from
/// `slaDueAt`/`firstResponseAt`/`resolvedAt` at read time (see
/// TicketsService.toTicketDto), same "reconstruct from real facts, don't
/// cache a derived flag" discipline as Phase 5's ledger balances.
model Ticket {
  id               String         @id @default(uuid()) @db.Uuid
  channelId        String?        @map("channel_id") @db.Uuid
  category         TicketCategory
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(NEW)
  subject          String
  slaDueAt         DateTime?      @map("sla_due_at")
  firstResponseAt  DateTime?      @map("first_response_at")
  resolvedAt       DateTime?      @map("resolved_at")
  closedAt         DateTime?      @map("closed_at")
  reopenCount      Int            @default(0) @map("reopen_count")
  assigneeId       String?        @map("assignee_id") @db.Uuid
  watcherIds       String[]       @map("watcher_ids") @db.Uuid
  linkedEntityType String?        @map("linked_entity_type")
  linkedEntityId   String?        @map("linked_entity_id") @db.Uuid
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  channel       Channel?             @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignee      User?                @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User                 @relation("TicketCreatedBy", fields: [createdById], references: [id])
  messages      TicketMessage[]
  internalNotes TicketInternalNote[]
  attachments   TicketAttachment[]
  statusEvents  TicketStatusEvent[]

  @@index([channelId])
  @@index([status])
  @@index([assigneeId])
  @@index([linkedEntityType, linkedEntityId])
  @@map("tickets")
}

/// Partner-visible correspondence. Structurally a completely separate table
/// from TicketInternalNote — the same "wholly separate model, not a flag on
/// a shared table" discipline Phase 2's EvaluationNote already established
/// — so no partner-facing serializer/endpoint can leak an internal note by
/// forgetting to filter a boolean.
model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

/// Internal-only. No partner-facing serializer/endpoint/export/notification
/// may ever select from this table (spec 18: "internal notes must never
/// appear in partner APIs, exports, notification text, or frontend
/// payloads") — this is the phase's own "internal-note leak" exit proof,
/// enforced by construction (a separate table TicketsService's partner DTOs
/// never join) and proven by a dedicated integration test.
model TicketInternalNote {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketInternalNoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_internal_notes")
}

/// Reuses Phase 1's FileAsset — same "reuse, don't rebuild" choice as every
/// other *Attachment table in this schema.
model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  fileAssetId String   @map("file_asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([ticketId, fileAssetId])
  @@map("ticket_attachments")
}

/// Durable transition log — the ticket's activity history (spec 18), same
/// shape as every prior phase's *StatusEvent table.
model TicketStatusEvent {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  note       String?
  createdBy  String?       @map("created_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_status_events")
}

enum NotificationChannelType {
  IN_APP
  SMS
  PUSH
  EMAIL
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Flat key+versionNumber+status versioning — same precedent as Phase 2's
/// EvaluationRubric (a version already used is never edited; a new one
/// supersedes it). PUSH/EMAIL are real enum members so the schema is ready
/// for those adapters (spec 19 "future push and email adapters"), even
/// though only IN_APP/SMS have a working provider this phase.
model NotificationTemplate {
  id            String                     @id @default(uuid()) @db.Uuid
  key           String
  versionNumber Int                        @map("version_number")
  channel       NotificationChannelType
  title         String
  body          String
  status        NotificationTemplateStatus @default(DRAFT)
  publishedAt   DateTime?                  @map("published_at")
  createdAt     DateTime                   @default(now()) @map("created_at")

  @@unique([key, versionNumber, channel])
  @@map("notification_templates")
}

/// One logical, in-app-inbox-visible notification per triggering event per
/// recipient. `mandatory` (spec 19 "mandatory security events") makes
/// delivery bypass quiet hours and per-event preference-off — see
/// NotificationsService.notify(). Read state lives directly on this row
/// (`readAt`), not a separate read-receipt table, since it's a single
/// per-user fact with no history worth keeping.
model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  eventType        String    @map("event_type")
  title            String
  body             String
  deepLink         String?   @map("deep_link")
  linkedEntityType String?   @map("linked_entity_type")
  linkedEntityId   String?   @map("linked_entity_id") @db.Uuid
  mandatory        Boolean   @default(false)
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED_QUIET_HOURS
  SKIPPED_PREFERENCE
}

/// One row per (notification, channel) delivery attempt-set. `dedupeKey` is
/// a real unique DB constraint — the exact "deduplication" mechanism spec
/// 19 asks for, same idempotency-key discipline as Phase 5's
/// LedgerTransaction. Retries are the Phase 0 outbox/BullMQ pipeline's own
/// `attempts`/backoff (see apps/worker's notification handler); `attempts`/
/// `lastError` here mirror what actually happened for operator visibility,
/// and a job that exhausts BullMQ's attempts lands this row at DEAD_LETTER
/// — the phase's own "failed-delivery queue."
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannelType
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  lastError         String?                    @map("last_error")
  providerMessageId String?                    @map("provider_message_id")
  dedupeKey         String                     @unique @map("dedupe_key")
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  smsDeliveryLog SmsDeliveryLog?

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

/// Per-user, per-event-type, per-channel opt-out (spec 19 "user
/// preferences"). Absence of a row means enabled — same "unknown is the
/// default, not a row you must pre-seed" choice as every other optional
/// preference in this schema.
model NotificationPreference {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  eventType String                  @map("event_type")
  channel   NotificationChannelType
  enabled   Boolean                 @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

/// Local-hour window (0-23, Asia/Tehran) during which non-mandatory
/// notifications are deferred rather than sent (spec 19 "quiet hours") —
/// deferred deliveries stay PENDING and are picked up by the next relay
/// tick once the window has passed, they are never dropped.
model NotificationQuietHours {
  userId    String @id @map("user_id") @db.Uuid
  startHour Int    @map("start_hour")
  endHour   Int    @map("end_hour")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_quiet_hours")
}

/// The actual SMS-provider call audit trail — distinct from
/// NotificationDelivery (which is channel-agnostic delivery *state*) per
/// spec 22's explicit `sms_delivery_logs` table. Never logs the message
/// body itself (OTP already sets this precedent in DevSmsProvider), only
/// the template id and provider response.
model SmsDeliveryLog {
  id                     String    @id @default(uuid()) @db.Uuid
  notificationDeliveryId String?   @unique @map("notification_delivery_id") @db.Uuid
  mobile                 String
  templateId             String    @map("template_id")
  providerMessageId      String?   @map("provider_message_id")
  status                 String
  errorMessage           String?   @map("error_message")
  requestedAt            DateTime  @default(now()) @map("requested_at")
  respondedAt            DateTime? @map("responded_at")

  notificationDelivery NotificationDelivery? @relation(fields: [notificationDeliveryId], references: [id], onDelete: SetNull)

  @@map("sms_delivery_logs")
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

/// A thin distribution/targeting wrapper around one Form (spec 10.11: "the
/// survey module ... must reuse the same form engine rather than creating a
/// second incompatible system") — the actual pages/sections/fields/rules,
/// draft/publish/version history, and every submission/revision/answer
/// still live entirely in Phase 2's Form/FormVersion/FormSubmission tables.
/// This row only adds what a survey needs that a form doesn't already have:
/// an open/close window and channel targeting. Empty `targetChannelIds`
/// means every active channel is in scope.
model Survey {
  id               String       @id @default(uuid()) @db.Uuid
  formId           String       @unique @map("form_id") @db.Uuid
  title            String
  status           SurveyStatus @default(DRAFT)
  targetChannelIds String[]     @map("target_channel_ids") @db.Uuid
  opensAt          DateTime?    @map("opens_at")
  closesAt         DateTime?    @map("closes_at")
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  form      Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@map("surveys")
}

enum ReportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReportVisibility {
  PRIVATE
  SHARED
}

/// A saved report configuration against one approved, code-defined dataset
/// key (spec 20: "approved semantic datasets, not unrestricted direct SQL")
/// — `datasetKey` is validated server-side against
/// `packages/database`'s `REPORT_DATASETS` registry, never used to build a
/// raw query string. `filters` is the user-chosen dimension/metric/filter/
/// date-range selection, shaped per-dataset.
model ReportDefinition {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  datasetKey  String           @map("dataset_key")
  filters     Json             @default("{}")
  visibility  ReportVisibility @default(PRIVATE)
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy User        @relation(fields: [createdById], references: [id])
  runs      ReportRun[]

  @@map("report_definitions")
}

/// One asynchronous execution of a dataset query (spec 20 "asynchronous
/// execution") — created PENDING, picked up by the same Phase 0 outbox ->
/// worker pipeline notification delivery uses, and updated to
/// RUNNING -> COMPLETED/FAILED by ReportsWorkerService. `resultJson` caches
/// the computed table so re-viewing a completed run never re-runs the
/// query; `reportDefinitionId` is nullable because ad-hoc (unsaved) runs
/// are allowed.
model ReportRun {
  id                 String          @id @default(uuid()) @db.Uuid
  reportDefinitionId String?         @map("report_definition_id") @db.Uuid
  datasetKey         String          @map("dataset_key")
  filters            Json            @default("{}")
  status             ReportRunStatus @default(PENDING)
  rowCount           Int?            @map("row_count")
  resultJson         Json?           @map("result_json")
  error              String?
  requestedById      String          @map("requested_by_id") @db.Uuid
  requestedAt        DateTime        @default(now()) @map("requested_at")
  completedAt        DateTime?       @map("completed_at")

  reportDefinition ReportDefinition? @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)
  requestedBy      User              @relation(fields: [requestedById], references: [id])
  snapshots        ReportSnapshot[]

  @@index([status])
  @@index([reportDefinitionId])
  @@map("report_runs")
}

enum ReportSnapshotFormat {
  JSON
  CSV
}

/// An immutable, point-in-time export of one completed ReportRun's result
/// (spec 20 "official snapshot" + "export audit" — creating one always goes
/// through AuditLogService). `content` holds the rendered export text
/// directly (CSV text or a JSON string) rather than routing through
/// FileAsset/MinIO — report exports are text-sized, not binary uploads, and
/// this keeps export generation independent of object-storage
/// availability.
model ReportSnapshot {
  id          String               @id @default(uuid()) @db.Uuid
  reportRunId String               @map("report_run_id") @db.Uuid
  format      ReportSnapshotFormat
  content     String
  rowCount    Int                  @map("row_count")
  createdById String               @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")

  reportRun ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([reportRunId])
  @@map("report_snapshots")
}
