# ---------------------------------------------------------------------------
# Hatef Platform — environment configuration
# Copy to .env and adjust. Values here are safe local-development defaults.
# The app refuses to start in production with known development secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_TIMEZONE=Asia/Tehran

# --- Ports -------------------------------------------------------------
API_PORT=4000
ADMIN_WEB_PORT=3000
PARTNER_WEB_PORT=3001
WORKER_PORT=4100

API_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:3000
PARTNER_WEB_URL=http://localhost:3001
# Inlined into the browser bundle at build time (Next.js NEXT_PUBLIC_ convention) —
# client components call the API directly (with credentials) for login/session/upload flows.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=hatef
POSTGRES_PASSWORD=hatef_dev_password
POSTGRES_DB=hatef
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hatef:hatef_dev_password@127.0.0.1:5432/hatef?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (MinIO in dev / S3-compatible in production) -----------
MINIO_ROOT_USER=hatef_minio
MINIO_ROOT_PASSWORD=hatef_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=hatef_minio
STORAGE_SECRET_ACCESS_KEY=hatef_minio_password
STORAGE_BUCKET=hatef-dev
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Auth / sessions ---------------------------------------------------
# Generate real secrets with: openssl rand -base64 48
SESSION_SECRET=dev_only_session_secret_change_me_please_1234567890
SESSION_COOKIE_NAME=hatef_session
OTP_HASH_PEPPER=dev_only_otp_pepper_change_me_please
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MFA_ISSUER=Hatef

# --- SMS provider (feature-flagged) ----------------------------------------
# dev provider logs OTPs to the server console/log instead of sending SMS.
# Live provider targets ملی‌پیامک (melipayamak.com) — fill these in and flip
# FEATURE_SMS_PROVIDER_LIVE + SMS_PROVIDER=live once an account exists.
SMS_PROVIDER=dev
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_SENDER=
SMS_TEMPLATE_OTP_ID=

# --- Object/file scanning ----------------------------------------------
ANTIVIRUS_PROVIDER=dev
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_CHANNEL=500

# --- Feature flags -------------------------------------------------------
FEATURE_SMS_PROVIDER_LIVE=false
FEATURE_WEB_PUSH=false
FEATURE_SURVEYS=true
# Skips the TOTP/MFA step after internal login — local convenience only.
# Refused at boot if NODE_ENV=production, and forced back to false in
# every test run regardless of this file (see backend/api/vitest.setup.ts).
FEATURE_SKIP_ADMIN_MFA_IN_DEV=false

# --- Web push (optional, feature-flagged) -----------------------------
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=

# --- Observability -------------------------------------------------------
LOG_LEVEL=debug

# --- API rate limiting (defense-in-depth beyond the OTP-specific limiter) --
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
